#!/bin/bash
# ============================================================
# Kubernetes 1.28 集群部署 - 集中变量配置
# 所有脚本 source 此文件，修改集群信息只改这一处
# ============================================================

# --- 集群版本 ---
KUBE_VERSION="1.28.15"
KUBE_VERSION_SHORT="1.28"
CONTAINERD_VERSION="1.6.28"
KUBEVIP_VERSION="v0.8.0"
CALICO_VERSION="v3.26.4"
CRICTL_VERSION="v1.28.0"

# ============================================================
# ★★★ 节点信息（要增减节点，只改这里两个列表）★★★
# 格式：每行一个节点，"IP 主机名"，用引号包起来
# ============================================================

# --- Master 节点（控制平面）---
# ⚠️ 数量必须是奇数：1 / 3 / 5 / 7
#    原因：每个 master 跑一个 etcd 成员，etcd 用 Raft 共识需多数派存活。
#    偶数不会提升容错还拖慢写入（2台容错0、4台容错1 与 3台相同）。
#    第一个 master 为初始化节点（执行 kubeadm init）。
MASTER_NODES=(
    "192.168.104.231 master1"
    "192.168.104.232 master2"
    "192.168.104.233 master3"
)

# --- Worker 节点（工作负载）---
# 数量任意，可为 0（纯 master 集群，需另配污点容忍）
WORKER_NODES=(
    "192.168.104.234 node1"
)

# ============================================================
# 以下为自动派生，通常无需修改
# ============================================================
MASTER_IPS=(); MASTER_NAMES=()
for _entry in "${MASTER_NODES[@]}"; do
    MASTER_IPS+=("$(echo $_entry | awk '{print $1}')")
    MASTER_NAMES+=("$(echo $_entry | awk '{print $2}')")
done
WORKER_IPS=(); WORKER_NAMES=()
for _entry in "${WORKER_NODES[@]}"; do
    WORKER_IPS+=("$(echo $_entry | awk '{print $1}')")
    WORKER_NAMES+=("$(echo $_entry | awk '{print $2}')")
done

# 汇总数组
ALL_IPS=("${MASTER_IPS[@]}" "${WORKER_IPS[@]}")
ALL_NAMES=("${MASTER_NAMES[@]}" "${WORKER_NAMES[@]}")

# 计数
MASTER_COUNT=${#MASTER_IPS[@]}
WORKER_COUNT=${#WORKER_IPS[@]}
TOTAL_COUNT=${#ALL_IPS[@]}

# 第一个 master = 初始化节点
MASTER1_IP="${MASTER_IPS[0]}"
MASTER1_NAME="${MASTER_NAMES[0]}"

# 向后兼容别名（老脚本仍可用这些名字遍历）
ALL_MASTERS=("${MASTER_IPS[@]}")
ALL_WORKERS=("${WORKER_IPS[@]}")
ALL_NODES=("${ALL_IPS[@]}")
ALL_MASTER_NAMES=("${MASTER_NAMES[@]}")
ALL_WORKER_NAMES=("${WORKER_NAMES[@]}")
ALL_NODE_NAMES=("${ALL_NAMES[@]}")

# master 数量奇偶校验（偶数给出警告，不阻断）
if [ $((MASTER_COUNT % 2)) -eq 0 ]; then
    echo "[⚠️ 警告] master 节点数为 ${MASTER_COUNT}（偶数），etcd 建议用奇数（1/3/5/7）" >&2
fi

# --- 网络配置 ---
# kube-vip VIP 地址（必须为同网段空闲 IP，部署前请确认未被占用）
VIP="192.168.104.200"
# kube-vip 网卡名（留空则自动探测默认路由网卡）
KUBEVIP_INTERFACE=""
# Pod 网段（不能用 192.168.0.0/16，会与宿主网段冲突）
POD_CIDR="10.244.0.0/16"
# kube-proxy Service 转发模式：Kubernetes 1.28 + CentOS 7 当前验证 ipvs。
# 可选：iptables；nftables 不属于本方案支持范围。
KUBE_PROXY_MODE="ipvs"
# 节点所在子网（备用；Calico 网卡探测优先用 CALICO_INTERFACE）
NODE_CIDR="192.168.104.0/24"
# ★ Calico 网卡探测：用具体网卡名（interface=），不要用 cidr=
#   原因：kube-proxy IPVS 模式会在 kube-ipvs0 虚拟网卡上挂 Service IP，
#   若某 Service 的 IP 落在节点网段内，cidr= 会误选 kube-ipvs0 导致
#   多节点探测到同一 IP → calico-node 崩溃（IP 冲突）。
#   留空则脚本自动探测默认路由网卡；多网卡或探测不准时手动填（如 ens192）。
CALICO_INTERFACE=""
# API Server 端口
API_SERVER_PORT="6443"

# --- 阿里云仓库 ---
# K8s 软件包源（1.28 必须用 kubernetes-new 新路径，旧的 mirrors.aliyun.com/kubernetes/ 已冻结）
KUBE_REPO_URL="https://mirrors.aliyun.com/kubernetes-new/core/stable/v${KUBE_VERSION_SHORT}/rpm"
KUBE_REPO_GPGKEY="${KUBE_REPO_URL}/repodata/repomd.xml.key"
# Docker-CE / containerd 源（私有仓库版：若已用本地 yum 源，此项可忽略）
DOCKER_CE_REPO="https://mirrors.aliyun.com/docker-ce/linux/centos/docker-ce.repo"

# ============================================================
# ★★★ 华为云 SWR 配置（必填）★★★
# ============================================================
# SWR 区域（region）
SWR_REGION="cn-southwest-2"
# SWR 组织名
SWR_ORG="zqli"
# 仓库地址 = swr.<region>.myhuaweicloud.com/<组织名>
PRIVATE_REGISTRY="swr.${SWR_REGION}.myhuaweicloud.com/${SWR_ORG}"

# --- SWR 登录凭据（push-to-registry.sh 推镜像用；private 组织时各节点拉取也用）---
# 获取方式：SWR 控制台 → 右上角"我的凭证" → 访问密钥(AK/SK)，
#   再用 AK 生成登录密钥（华为云文档"客户端上传→生成临时/长期登录指令"）。
#   用户名固定格式：<region>@<AK>    密码：由 AK/SK 生成的登录密钥
SWR_AK=""                    # 你的 Access Key ID（只填 AK，不要带 region@ 前缀）
SWR_LOGIN_KEY=""             # 生成的登录密钥
SWR_USERNAME="${SWR_REGION}@${SWR_AK#*@}"

# --- TLS：SWR 用华为云受信 CA 证书，无需自签信任配置 ---
REGISTRY_CA_FILE=""
REGISTRY_TLS_INSECURE="false"   # SWR 证书受信，不跳过校验
REGISTRY_PROTOCOL="https"

# --- 组织权限：private（私有）→ 需在每个节点 containerd 配 SWR 认证 ---
# 因为控制面/kube-vip 是 static pod，由 kubelet 直接拉取，不认 imagePullSecrets，
# 必须在 containerd 层配认证。02 脚本会据此写认证到 hosts.toml。
SWR_PRIVATE="true"

# 以下全部指向 SWR，无需修改（跟随 PRIVATE_REGISTRY 变化）
# K8s 核心镜像：kubeadm imageRepository（自动追加 /kube-apiserver 等）
IMAGE_REPOSITORY="${PRIVATE_REGISTRY}/google_containers"
# pause 镜像
PAUSE_IMAGE="${IMAGE_REPOSITORY}/pause:3.9"
# Calico 镜像前缀（镜像为 ${PRIVATE_REGISTRY}/calico/node 等）
CALICO_IMAGE_REGISTRY="${PRIVATE_REGISTRY}/docker.io"
# kube-vip 镜像
KUBEVIP_IMAGE="${PRIVATE_REGISTRY}/ghcr.io/kube-vip/kube-vip:${KUBEVIP_VERSION}"
# Calico manifest：私有仓库版用本地文件（manifests/calico.yaml），不联网下载
CALICO_MANIFEST_URL=""

# --- 证书 ---
# 证书有效期天数（10年 = 3650天）
CERT_DAYS=3650

# --- 离线部署相关 ---
OFFLINE_DIR="/opt/k8s-offline"
LOCAL_REPO_DIR="${OFFLINE_DIR}/rpms"
LOCAL_IMAGES_DIR="${OFFLINE_DIR}/images"
LOCAL_BIN_DIR="${OFFLINE_DIR}/bin"
LOCAL_MANIFESTS_DIR="${OFFLINE_DIR}/manifests"
