#!/bin/bash
# ============================================================
# Kubernetes 1.28 集群部署 - 集中变量配置（Ubuntu 在线版）
# 所有脚本 source 此文件，修改集群信息只改这一处
# 适用：Ubuntu 22.04 (jammy) / 24.04 (noble)，apt 包管理
# ============================================================

# --- 集群版本 ---
KUBE_VERSION="1.28.15"
KUBE_VERSION_SHORT="1.28"
CONTAINERD_VERSION="1.6.28"
KUBEVIP_VERSION="v0.8.0"
CALICO_VERSION="v3.26.4"
CRICTL_VERSION="v1.28.0"

# ============================================================
# ★★★ 节点信息（要增减节点，只改这里两个列表）★★★
# 格式：每行一个节点，"IP 主机名"，用引号包起来
# ============================================================

# --- Master 节点（控制平面）---
# ⚠️ 数量必须是奇数：1 / 3 / 5 / 7
#    原因：每个 master 跑一个 etcd 成员，etcd 用 Raft 共识需多数派存活。
#    第一个 master 为初始化节点（执行 kubeadm init）。
MASTER_NODES=(
    "10.0.0.100 master1"
    "10.0.0.101 master2"
    "10.0.0.102 master3"
)

# --- Worker 节点（工作负载）---
# 数量任意，可为 0（纯 master 集群，需另配污点容忍）
WORKER_NODES=(
    "10.0.0.103 node1"
)

# ============================================================
# 以下为自动派生，通常无需修改
# ============================================================
MASTER_IPS=(); MASTER_NAMES=()
for _entry in "${MASTER_NODES[@]}"; do
    MASTER_IPS+=("$(echo $_entry | awk '{print $1}')")
    MASTER_NAMES+=("$(echo $_entry | awk '{print $2}')")
done
WORKER_IPS=(); WORKER_NAMES=()
for _entry in "${WORKER_NODES[@]}"; do
    WORKER_IPS+=("$(echo $_entry | awk '{print $1}')")
    WORKER_NAMES+=("$(echo $_entry | awk '{print $2}')")
done

# 汇总数组
ALL_IPS=("${MASTER_IPS[@]}" "${WORKER_IPS[@]}")
ALL_NAMES=("${MASTER_NAMES[@]}" "${WORKER_NAMES[@]}")

# 计数
MASTER_COUNT=${#MASTER_IPS[@]}
WORKER_COUNT=${#WORKER_IPS[@]}
TOTAL_COUNT=${#ALL_IPS[@]}

# 第一个 master = 初始化节点
MASTER1_IP="${MASTER_IPS[0]}"
MASTER1_NAME="${MASTER_NAMES[0]}"

# 向后兼容别名（老脚本仍可用这些名字遍历）
ALL_MASTERS=("${MASTER_IPS[@]}")
ALL_WORKERS=("${WORKER_IPS[@]}")
ALL_NODES=("${ALL_IPS[@]}")
ALL_MASTER_NAMES=("${MASTER_NAMES[@]}")
ALL_WORKER_NAMES=("${WORKER_NAMES[@]}")
ALL_NODE_NAMES=("${ALL_NAMES[@]}")

# master 数量奇偶校验（偶数给出警告，不阻断）
if [ $((MASTER_COUNT % 2)) -eq 0 ]; then
    echo "[⚠️ 警告] master 节点数为 ${MASTER_COUNT}（偶数），etcd 建议用奇数（1/3/5/7）" >&2
fi

# --- Ubuntu 版本 ---
# codename：jammy=22.04 / noble=24.04。
# 留空则脚本自动从 /etc/os-release 探测（VERSION_CODENAME）；手动指定可覆盖。
UBUNTU_CODENAME=""

# --- 网络配置 ---
# kube-vip VIP 地址（必须为同网段空闲 IP，部署前请确认未被占用）
VIP="10.0.0.200"
# kube-vip 网卡名（留空则自动探测默认路由网卡）
KUBEVIP_INTERFACE=""
# Pod 网段（不能用 192.168.0.0/16，会与宿主网段冲突）
POD_CIDR="10.244.0.0/16"
# ★ Service 网段（04-init-master1.sh 会用到；kubeadm 默认 10.96.0.0/12）
SERVICE_CIDR="10.96.0.0/12"
# kube-proxy Service 转发模式：Kubernetes 1.28 当前支持 ipvs 或 iptables。
# nftables 不属于本方案验证范围。
KUBE_PROXY_MODE="ipvs"
# 节点所在子网（备用；Calico 网卡探测优先用 CALICO_INTERFACE）
NODE_CIDR="10.0.0.0/24"
# ★ Calico 网卡探测：用具体网卡名（interface=），不要用 cidr=
#   原因：kube-proxy IPVS 模式会在 kube-ipvs0 虚拟网卡上挂 Service IP，
#   若某 Service 的 IP 落在节点网段内，cidr= 会误选 kube-ipvs0 导致
#   多节点探测到同一 IP → calico-node 崩溃（IP 冲突）。
#   留空则脚本自动探测默认路由网卡；多网卡或探测不准时手动填（如 ens192/ens33）。
CALICO_INTERFACE=""
# API Server 端口
API_SERVER_PORT="6443"

# --- 阿里云仓库（deb 源，Ubuntu 专用）---
# K8s 软件包源（1.28 必须用 kubernetes-new 新路径，旧的 mirrors.aliyun.com/kubernetes/ 已冻结）
KUBE_REPO_URL="https://mirrors.aliyun.com/kubernetes-new/core/stable/v${KUBE_VERSION_SHORT}/deb"
KUBE_REPO_GPGKEY="${KUBE_REPO_URL}/Release.key"
# Docker-CE / containerd 源（Ubuntu，路径带 codename，脚本会自动拼接 jammy/noble）
DOCKER_CE_REPO="https://mirrors.aliyun.com/docker-ce/linux/ubuntu"
DOCKER_CE_GPGKEY="${DOCKER_CE_REPO}/gpg"

# --- 镜像仓库（★ 与宿主 OS 无关，Ubuntu/CentOS 完全一致，无需重推）---
# K8s 核心镜像：阿里云 google_containers 同步源
IMAGE_REPOSITORY="registry.aliyuncs.com/google_containers"
# pause 镜像（1.28 对应 pause:3.9）
PAUSE_IMAGE="${IMAGE_REPOSITORY}/pause:3.9"
# Calico 镜像源前缀（国内 docker.io 不可达，用 DaoCloud 加速；脚本会把 docker.io 替换为此前缀）
CALICO_IMAGE_REGISTRY="m.daocloud.io/docker.io"
# kube-vip 镜像（ghcr.io 官方源，国内慢但可拉）
KUBEVIP_IMAGE="ghcr.io/kube-vip/kube-vip:${KUBEVIP_VERSION}"
# Calico manifest 下载地址（raw.githubusercontent.com 国内被墙，用 gitee 镜像）
# 官方: https://raw.githubusercontent.com/projectcalico/calico/${CALICO_VERSION}/manifests/calico.yaml
CALICO_MANIFEST_URL="https://gitee.com/mirrors/calico/raw/${CALICO_VERSION}/manifests/calico.yaml"

# --- 证书 ---
# 证书有效期天数（10年 = 3650天）
CERT_DAYS=3650

# --- 离线部署相关 ---
OFFLINE_DIR="/opt/k8s-offline"
LOCAL_REPO_DIR="${OFFLINE_DIR}/packages"
LOCAL_IMAGES_DIR="${OFFLINE_DIR}/images"
LOCAL_BIN_DIR="${OFFLINE_DIR}/bin"
LOCAL_MANIFESTS_DIR="${OFFLINE_DIR}/manifests"
